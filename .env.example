# Server Configuration
PORT=3000
NODE_ENV="development"

# PostgreSQL Configuration
# In production or self-hosted, configure your PostgreSQL connection:
SQL_HOST="localhost"
SQL_PORT=5432
SQL_USER="postgres"
SQL_PASSWORD="password"
SQL_DB_NAME="kharrazi_db"
DATABASE_URL="postgres://postgres:password@localhost:5432/kharrazi_db"

# GEMINI_API_KEY: Optional for intelligent assistant features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
